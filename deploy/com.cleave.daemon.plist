<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd service for Cleave (macOS equivalent of cleave.service).

  Install:
    cp deploy/com.cleave.daemon.plist ~/Library/LaunchAgents/
    # Edit WorkingDirectory, UserName, and log paths below to match your setup.
    launchctl load ~/Library/LaunchAgents/com.cleave.daemon.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.cleave.daemon.plist

  Logs (default paths below):
    ~/Library/Logs/cleave/cleave.log
    ~/Library/Logs/cleave/cleave-error.log

  NOTE: create the log directory first:
    mkdir -p ~/Library/Logs/cleave
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cleave.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Absolute path to run.sh in your clone. Adjust as needed. -->
        <string>/Users/YOUR_USER/cleave/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <!-- Absolute path to the Cleave repo root. Adjust as needed. -->
    <string>/Users/YOUR_USER/cleave</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Point at your .env file so run.sh's `source .env` is redundant
             but the daemon inherits all required tokens directly. -->
        <key>HOME</key>
        <string>/Users/YOUR_USER</string>
    </dict>

    <!-- Start automatically at login and keep alive if it exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USER/Library/Logs/cleave/cleave.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USER/Library/Logs/cleave/cleave-error.log</string>
</dict>
</plist>
