# Cleave Environment Variables
# Copy to /etc/cleave/environment and fill in values.

# --- Anthropic / Claude ---
# API key for Claude LLM calls. Variable name matches what config_loader
# substitutes into config-live/global.yaml ("${CLAUDE_API_KEY}").
CLAUDE_API_KEY=

# --- Jira ---
# Jira Cloud instance URL (e.g., https://your-org.atlassian.net)
JIRA_URL=
# Jira API token (generate at https://id.atlassian.com/manage/api-tokens)
JIRA_TOKEN=
# Email associated with the Jira account
JIRA_EMAIL=

# --- GitHub ---
# Personal access token with repo scope
GITHUB_TOKEN=

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID for escalation messages
TELEGRAM_CHAT_ID=

# --- Agent Bash timeouts (optional) ---
# Cleave gives the agents' Bash commands 15 minutes by default and 25 at most, so a Gradle build can finish.
# Set these to override; keep the maximum under 30 minutes, where the stall watchdog kills a silent run.
# BASH_DEFAULT_TIMEOUT_MS=900000
# BASH_MAX_TIMEOUT_MS=1500000
