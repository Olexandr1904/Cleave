<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: render it with scripts/render_launchd_plist.py as deploy/README.md ("Running on macOS (launchd)") shows. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cleave.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{CLEAVE_DIR}}/run.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{CLEAVE_DIR}}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>{{HOME}}</string>
		<key>USER</key>
		<string>{{USER}}</string>
		<key>PATH</key>
		<string>{{PATH}}</string>
		<key>LANG</key>
		<string>{{LANG}}</string>
		<key>TMPDIR</key>
		<string>{{TMPDIR}}</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>CLEAVE_STDERR_LEVEL</key>
		<string>WARNING</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/cleave/cleave.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/cleave/cleave-error.log</string>
</dict>
</plist>
